<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- Título -->
            <TextView
                android:id="@+id/textViewDatosCable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="20dp"
                android:background="@color/fondoTitulo"
                android:fontFamily="sans-serif-medium"
                android:text="Datos Cables"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:textStyle="bold"
                android:padding="5dp" />

            <!-- Datos -->
            <TextView
                android:id="@+id/textViewNombreCircuito"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Nombre del circuito:"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/editTextNombreCircuito"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Nombre del circuito"
                android:inputType="text"
                android:padding="5dp"
                android:textSize="24sp" />

            <!-- Error 1 -->
            <TextView
                android:id="@+id/error1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"

                app:layout_constraintTop_toBottomOf="@id/editTextNombreCircuito"
                app:layout_constraintStart_toStartOf="@id/editTextNombreCircuito"
                app:layout_constraintEnd_toEndOf="@id/editTextNombreCircuito"/>

            <TextView
                android:id="@+id/textViewPotencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Potencia:"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/editTextPotencia"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Potencia"
                android:inputType="text"
                android:padding="5dp"
                android:textSize="24sp" />

            <!-- Error 2 -->
            <TextView
                android:id="@+id/error2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/editTextPotencia"
                app:layout_constraintStart_toStartOf="@id/editTextPotencia"
                app:layout_constraintEnd_toEndOf="@id/editTextPotencia"/>


            <TextView
                android:id="@+id/textViewTipoTension"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Tipo de tensión:"
                android:textSize="24sp" />

            <Spinner
                android:id="@+id/spinner1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:drawable/btn_dropdown" />



            <!--Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonAtras"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fondoBotones"
                    android:fontFamily="sans-serif-medium"
                    android:text="Atrás"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/botonSiguiente"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fondoBotones"
                    android:fontFamily="sans-serif-medium"
                    android:text="Siguiente"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>