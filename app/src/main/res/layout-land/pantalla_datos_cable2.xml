<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- Título -->
            <TextView
                android:id="@+id/textViewDatosCable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="20dp"
                android:background="@color/fondoTitulo"
                android:fontFamily="sans-serif-medium"
                android:text="Datos Cables"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:textStyle="bold"
                android:padding="5dp" />

            <!-- Datos -->
            <TextView
                android:id="@+id/textViewLongitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Longitud:"
                android:textSize="24sp" />

            <EditText
                android:id="@+id/editTextLongitud"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Longitud"
                android:inputType="text"
                android:padding="5dp"
                android:textSize="24sp" />

            <!-- Error 4 -->
            <TextView
                android:id="@+id/error4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/editTextLongitud"
                app:layout_constraintStart_toStartOf="@id/editTextLongitud"
                app:layout_constraintEnd_toEndOf="@id/editTextLongitud"/>

            <TextView
                android:id="@+id/textViewCaidaTensionMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:text="Caída de tensión máxima:"
                android:textSize="24sp" />

            <Spinner
                android:id="@+id/spinner2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:drawable/btn_dropdown" />

            <TextView
                android:id="@+id/textViewProteccionSelec"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Protección seleccionada (A):"
                android:textSize="24sp" />

            <!-- Cuadro automatico -->
            <!-- En duda, por defecto puesto como automatico -->
            <TextView
                android:id="@+id/textViewProteccionSelecMensaje"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Protección seleccionada (A)"
                android:padding="5dp"
                android:textSize="24sp" />

            <!-- Error 5 -->
            <TextView
                android:id="@+id/error5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/textViewProteccionSelecMensaje"
                app:layout_constraintStart_toStartOf="@id/textViewProteccionSelecMensaje"
                app:layout_constraintEnd_toEndOf="@id/textViewProteccionSelecMensaje"/>

            <!-- Cuadro automatico -->
            <TextView
                android:id="@+id/textViewProteccionTermica"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Protección térmica:"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/textViewProteccionTermicaMensaje"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Protección térmica"
                android:padding="5dp"
                android:textSize="24sp" />

            <!-- Error 6 -->
            <TextView
                android:id="@+id/error6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/textViewProteccionTermicaMensaje"
                app:layout_constraintStart_toStartOf="@id/textViewProteccionTermicaMensaje"
                app:layout_constraintEnd_toEndOf="@id/textViewProteccionTermicaMensaje"/>

            <!-- CAMBIADO A LA PANTALLA 3 -->
