            <!--                android:layout_marginHorizontal="20dp"-->
            <!--                android:background="@drawable/recuadro_texto"-->
            <!--                android:ems="10"-->
            <!--                android:fontFamily="sans-serif-medium"-->
            <!--                android:hint="Protección diferencial"-->
            <!--                android:inputType="text"-->
            <!--                android:padding="5dp"-->
            <!--                android:textSize="24sp" />-->

            <!--            &lt;!&ndash; Error 7 &ndash;&gt;-->
            <!--            <TextView-->
            <!--                android:id="@+id/error7"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginTop="4dp"-->
            <!--                android:layout_marginBottom="10dp"-->
            <!--                android:layout_marginHorizontal="20dp"-->
            <!--                android:textColor="@color/textoErrores"-->
            <!--                android:textSize="14sp"-->
            <!--                android:fontFamily="sans-serif-medium"-->
            <!--                android:text=""-->
            <!--                android:visibility="gone"-->
            <!--                app:layout_constraintTop_toBottomOf="@id/editTextProteccionDiferencial"-->
            <!--                app:layout_constraintStart_toStartOf="@id/editTextProteccionDiferencial"-->
            <!--                app:layout_constraintEnd_toEndOf="@id/editTextProteccionDiferencial"/>-->

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonAtras"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fondoBotones"
                    android:fontFamily="sans-serif-medium"
                    android:text="Atrás"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/botonSiguiente"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
