<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <!-- Título -->
            <TextView
                android:id="@+id/textViewDatosCable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="25dp"
                android:layout_marginBottom="20dp"
                android:background="@color/fondoTitulo"
                android:fontFamily="sans-serif-medium"
                android:text="Datos Cables"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="35sp"
                android:textStyle="bold"
                android:padding="5dp" />

            <!-- Datos -->
            <TextView
                android:id="@+id/textViewTipoConductor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Tipo del conductor 1:"
                android:textSize="24sp" />

            <Spinner
                android:id="@+id/spinner5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:drawable/btn_dropdown" />

            <TextView
                android:id="@+id/textViewTipoConductor2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Tipo del conductor 2:"
                android:textSize="24sp" />

            <Spinner
                android:id="@+id/spinner6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:drawable/btn_dropdown" />

            <TextView
                android:id="@+id/textViewLocalizacionCanalizacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Localización de canalización:"
                android:textSize="24sp" />

            <Spinner
                android:id="@+id/spinner7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:background="@android:drawable/btn_dropdown" />

            <TextView
                android:id="@+id/textViewFactorCorreccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Factor de corrección del lugar:"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/editTextFactorCorreccion"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Factor de corrección del lugar"
                android:inputType="text"
                android:padding="5dp"
                android:textSize="22sp" />

            <!-- Error 9 -->
            <TextView
                android:id="@+id/error9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/editTextFactorCorreccion"
                app:layout_constraintStart_toStartOf="@id/editTextFactorCorreccion"
                app:layout_constraintEnd_toEndOf="@id/editTextFactorCorreccion"/>

            <TextView
                android:id="@+id/textViewCaidaTensionMaxTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_marginHorizontal="20dp"
                android:fontFamily="sans-serif-medium"
                android:text="Caida de tension máxima:"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/textViewCaidaTensionMax"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:background="@drawable/recuadro_texto"
                android:ems="10"
                android:fontFamily="sans-serif-medium"
                android:hint="Caida de tension max"
                android:padding="5dp"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/error10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="10dp"
                android:layout_marginHorizontal="20dp"
                android:textColor="@color/textoErrores"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:text=""
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@id/editTextFactorCorreccion"
                app:layout_constraintStart_toStartOf="@id/editTextFactorCorreccion"
                app:layout_constraintEnd_toEndOf="@id/editTextFactorCorreccion"/>

            <!-- Botones -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginHorizontal="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/botonAtras"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fondoBotones"
                    android:fontFamily="sans-serif-medium"
                    android:text="Atrás"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/botonSiguiente"
                    android:layout_width="0dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/fondoBotones"
                    android:fontFamily="sans-serif-medium"
                    android:text="Terminar"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>